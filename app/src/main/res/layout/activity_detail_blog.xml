<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="data"
            type="com.test.murni.ui.activity.detail_blog.DetailBlogViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include layout="@layout/nav_bar_layout" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_blog"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_launcher_background"
                    android:layout_marginBottom="@dimen/space_xlarge"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_blog_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_margin="@dimen/space_xlarge"
                    android:textColor="@color/grey_1"
                    android:textSize="@dimen/text_large"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:lines="2"
                    android:ellipsize="end"
                    tools:text="THE BOY AND THE HERON" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_news_site"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    tools:text="News Site : Nasa" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_xlarge"
                    tools:text="News Site : Nasa" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</layout>